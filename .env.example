# Server-only Cloudflare R2 configuration. Never prefix these with VITE_.
# The repository bucket stores private originals. Disable its r2.dev URL and
# remove any public custom domain before deployment.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Use a separate private bucket for immutable audit records. Do not attach an
# r2.dev URL or public custom domain to this bucket either.
R2_AUDIT_BUCKET_NAME=

# Optional override for jurisdiction-specific or local S3 API endpoints.
# Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Public Firebase web-app configuration used by the React authentication client.
# These identifiers are safe for the browser; authorization still happens server-side.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only Firebase Admin service-account credentials. Never prefix with VITE_.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Store the private key on one line with literal \n sequences between key lines.
FIREBASE_ADMIN_PRIVATE_KEY=
# Firebase Authentication UID of the initial repository administrator.
FIREBASE_BOOTSTRAP_ADMIN_UID=
